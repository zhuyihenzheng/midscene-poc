# Midscene エンジン用（ローカル LM・OpenAI 互換）。Playwright エンジンのみなら不要
MIDSCENE_MODEL_BASE_URL=http://localhost:1234/v1
MIDSCENE_MODEL_API_KEY=lm-studio
MIDSCENE_MODEL_NAME=qwen-main
MIDSCENE_MODEL_FAMILY=qwen3

# 実行エンジンの既定（midscene / playwright）。各 run.mjs の --engine で上書き
TEST_ENGINE=midscene
# Playwright が使うブラウザ：chrome（既定）/ msedge / 空で同梱 Chromium
TEST_BROWSER_CHANNEL=chrome
# 1 でブラウザを表示して実行
TEST_HEADED=0

# サイトごとのログイン項目はここに追加する（例：MYSITE_USER= / MYSITE_PASS=。実環境の資格情報は .env にだけ書く）

# coupon-demo（デモサイト）。未設定なら既定値（ポート 8090・会員 M0001）
COUPON_DEMO_PORT=
COUPON_DEMO_FIXED=
