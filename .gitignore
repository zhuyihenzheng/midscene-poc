# Local configuration and credentials
.env
.env.*
!.env.example

# Dependencies and generated run artifacts
node_modules/
midscene_run/
*.log

# Screenshots and recordings may contain live application data
*.jpg
*.jpeg
*.png
*.webp

# サイト別の実行結果（core/runner.mjs の出力）
sites/*/tests/out/
sites/*/tests/evidence/

# ローカル専用の試験（リポジトリに含めない）
kmt/

# 画面の証跡を埋め込んだレポート・CI 用の結果
sites/*/tests/report.html
.test-results/

# エージェントをモデルにする中継サーバー（core/agent-model.mjs）の要求・画面
.agent-model/

# 外部の試験対象アプリ（sites/flaskr）。リポジトリに含めない
.ext/
