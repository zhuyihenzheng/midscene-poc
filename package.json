{
  "name": "midscene-poc",
  "version": "1.0.0",
  "description": "Browser screen-testing framework on Midscene and Playwright",
  "scripts": {
    "test": "node --test --test-concurrency=1 test/unit.test.mjs test/engine.test.mjs test/ai.test.mjs test/agent-model.test.mjs test/demo.test.mjs",
    "test:unit": "node --test test/unit.test.mjs",
    "demo": "node sites/coupon-demo/tests/run.mjs --engine playwright",
    "demo:fixed": "node sites/coupon-demo/tests/run-fixed.mjs",
    "build": "node sites/coupon-demo/tests/run.mjs --engine playwright --build-only",
    "explore": "node core/explore.mjs",
    "new-site": "node core/new-site.mjs",
    "demo:legacy": "node sites/legacy-demo/tests/run.mjs --engine playwright"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@midscene/cli": "^1.15.3",
    "@midscene/web": "^1.15.3",
    "@playwright/test": "^1.64.0",
    "playwright": "^1.64.0"
  },
  "dependencies": {
    "dotenv": "^16.6.1",
    "exceljs": "^4.4.0",
    "js-yaml": "^4.1.0",
    "pixelmatch": "^5.3.0",
    "pngjs": "^7.0.0"
  },
  "engines": {
    "node": ">=20"
  }
}
